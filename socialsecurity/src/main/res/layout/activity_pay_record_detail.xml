<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff"
    android:orientation="vertical">

    <include
        android:id="@+id/header"
        layout="@layout/view_top" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="#E4E5E9" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/dp_10_15"
                android:paddingTop="@dimen/dp_10_15"
                android:paddingRight="@dimen/dp_10_15">

                <LinearLayout
                    android:id="@+id/ll_yanglao"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_50_75"
                    android:layout_weight="1"
                    android:background="@mipmap/jlzc_k1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/sp_23_41"
                        android:layout_height="@dimen/sp_23_41"
                        android:layout_marginLeft="@dimen/dp_7_8"
                        android:layout_marginRight="@dimen/dp_3_5"
                        android:src="@mipmap/icon_gdgj_1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_3_5"
                        android:text="养老保险"
                        android:textColor="#ff333333"
                        android:textSize="@dimen/sp_9_13" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_yiliao"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_50_75"
                    android:layout_marginLeft="@dimen/dp_5_7"
                    android:layout_weight="1"
                    android:background="@mipmap/wdsbzd_k1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/sp_23_41"
                        android:layout_height="@dimen/sp_23_41"
                        android:layout_marginLeft="@dimen/dp_7_8"
                        android:layout_marginRight="@dimen/dp_3_5"
                        android:src="@mipmap/icon_gdgj_2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_3_5"
                        android:text="医疗保险"
                        android:textColor="#ff333333"
                        android:textSize="@dimen/sp_9_13" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_shiye"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_50_75"
                    android:layout_marginLeft="@dimen/dp_5_7"
                    android:layout_weight="1"
                    android:background="@mipmap/wdsbzd_k1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/sp_23_41"
                        android:layout_height="@dimen/sp_23_41"
                        android:layout_marginLeft="@dimen/dp_7_8"
                        android:layout_marginRight="@dimen/dp_3_5"
                        android:src="@mipmap/icon_gdgj_3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_3_5"
                        android:text="失业保险"
                        android:textColor="#ff333333"
                        android:textSize="@dimen/sp_9_13" />

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_5_7"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/dp_10_15"
                android:paddingRight="@dimen/dp_10_15">

                <LinearLayout
                    android:id="@+id/ll_gongshang"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_50_75"
                    android:layout_weight="1"
                    android:background="@mipmap/wdsbzd_k1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/sp_23_41"
                        android:layout_height="@dimen/sp_23_41"
                        android:layout_marginLeft="@dimen/dp_7_8"
                        android:layout_marginRight="@dimen/dp_3_5"
                        android:src="@mipmap/icon_gdgj_4" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_3_5"
                        android:text="工伤保险"
                        android:textColor="#ff333333"
                        android:textSize="@dimen/sp_9_13" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_shengyu"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_50_75"
                    android:layout_marginLeft="@dimen/dp_5_7"
                    android:layout_weight="1"
                    android:background="@mipmap/wdsbzd_k1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/sp_23_41"
                        android:layout_height="@dimen/sp_23_41"
                        android:layout_marginLeft="@dimen/dp_7_8"
                        android:layout_marginRight="@dimen/dp_3_5"
                        android:src="@mipmap/icon_gdgj_5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_3_5"
                        android:text="生育保险"
                        android:textColor="#ff333333"
                        android:textSize="@dimen/sp_9_13" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_50_75"
                    android:layout_marginLeft="@dimen/dp_5_7"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/fl_info_ad_tax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_5_7" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="50dp" />

            <LinearLayout
                android:id="@+id/ll_calendar"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_20_30"
                android:layout_marginLeft="@dimen/dp_10_15"
                android:background="@mipmap/jlzc_k2"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="@dimen/dp_5_7">

                <ImageView
                    android:layout_width="@dimen/dp_10_15"
                    android:layout_height="@dimen/dp_10_15"
                    android:src="@mipmap/jlzc_rl" />

                <TextView
                    android:id="@+id/tv_calendar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_3_5"
                    android:text="202510"
                    android:textColor="#ff3875f6"
                    android:textSize="@dimen/sp_9_13" />
            </LinearLayout>

            <com.rzm.socialsecurity.widget.CustomEditText
                android:id="@+id/et_month_money"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_24_36"
                android:layout_marginLeft="@dimen/dp_8_12"
                android:layout_marginTop="@dimen/dp_5_7"
                android:layout_marginRight="@dimen/dp_15_22"
                android:background="@drawable/edit_bg"
                android:inputType="numberDecimal"
                android:paddingStart="@dimen/dp_5_7"
                android:text="0"
                android:textColor="#ffff2222"
                android:textSelectHandle="@drawable/none_drawable"
                android:textSelectHandleLeft="@drawable/none_drawable"
                android:textSelectHandleRight="@drawable/none_drawable"
                android:textSize="@dimen/sp_10_15" />

            <LinearLayout
                android:id="@+id/ll_save"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_32_48"
                android:layout_marginLeft="@dimen/dp_20_30"
                android:layout_marginBottom="@dimen/dp_20_30"
                android:layout_marginTop="@dimen/dp_10_15"
                android:layout_marginRight="@dimen/dp_20_30"
                android:background="@drawable/btn_bg"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_5_7"
                    android:gravity="center"
                    android:text="保存"
                    android:textColor="#ffffffff"
                    android:textSize="@dimen/sp_11_16" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

