<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fff"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ll_top"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_106_159"
        android:background="@mipmap/sbjs_banner"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40_60"
            android:layout_marginTop="@dimen/dp_15_22"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="@dimen/dp_30_45"
                android:layout_height="@dimen/dp_30_45"
                android:paddingEnd="@dimen/dp_20_30"
                android:layout_marginStart="@dimen/dp_10_15"
                android:src="@mipmap/sb_fh" />
        </LinearLayout>

    </LinearLayout>


    <TextView
        android:id="@+id/tv_jnjs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_10_15"
        android:layout_marginTop="@dimen/dp_10_15"
        android:text="总缴纳"
        android:textColor="#ff333333"
        android:textSize="@dimen/sp_9_13" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_26_39"
        android:layout_marginLeft="@dimen/dp_10_15"
        android:layout_marginTop="@dimen/dp_5_7"
        android:layout_marginRight="@dimen/dp_10_15"
        android:background="@drawable/edit_bg"
        android:gravity="center_vertical"
        android:paddingRight="@dimen/dp_15_22">

        <TextView
            android:id="@+id/tv_month_money"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_24_36"
            android:layout_marginLeft="@dimen/dp_8_12"
            android:layout_marginRight="@dimen/dp_15_22"
            android:layout_weight="1"
            android:background="#fff"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/dp_5_7"
            android:text="1111"
            android:textColor="#ff333333"
            android:textSize="@dimen/sp_10_15" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="元"
            android:textColor="#ff333333"
            android:textSize="@dimen/sp_10_15" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_10_15"
        android:layout_marginTop="@dimen/dp_10_15"
        android:text="社保个人部分"
        android:textColor="#ff333333"
        android:textSize="@dimen/sp_9_13" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_26_39"
        android:layout_marginLeft="@dimen/dp_10_15"
        android:layout_marginTop="@dimen/dp_5_7"
        android:layout_marginRight="@dimen/dp_10_15"
        android:background="@drawable/edit_bg"
        android:gravity="center_vertical"
        android:paddingRight="@dimen/dp_15_22">

        <TextView
            android:id="@+id/tv_sb_money"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_24_36"
            android:layout_marginLeft="@dimen/dp_8_12"
            android:layout_marginRight="@dimen/dp_15_22"
            android:layout_weight="1"
            android:background="#fff"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/dp_5_7"
            android:text="1111"
            android:textColor="#ff333333"
            android:textSize="@dimen/sp_10_15" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="元"
            android:textColor="#ff333333"
            android:textSize="@dimen/sp_10_15" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_10_15"
        android:layout_marginTop="@dimen/dp_10_15"
        android:text="缴纳之后薪资"
        android:textColor="#ff333333"
        android:textSize="@dimen/sp_9_13" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_26_39"
        android:layout_marginLeft="@dimen/dp_10_15"
        android:layout_marginTop="@dimen/dp_5_7"
        android:layout_marginRight="@dimen/dp_10_15"
        android:background="@drawable/edit_bg"
        android:gravity="center_vertical"
        android:paddingRight="@dimen/dp_15_22">

        <TextView
            android:id="@+id/tv_money"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_24_36"
            android:layout_marginLeft="@dimen/dp_8_12"
            android:layout_marginRight="@dimen/dp_15_22"
            android:layout_weight="1"
            android:background="#fff"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/dp_5_7"
            android:text="1111"
            android:textColor="#ff333333"
            android:textSize="@dimen/sp_10_15" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="元"
            android:textColor="#ff333333"
            android:textSize="@dimen/sp_10_15" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fl_info_ad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="@dimen/dp_10_15"/>
</LinearLayout>