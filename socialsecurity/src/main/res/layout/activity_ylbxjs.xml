<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ll_top"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_106_159"
        android:background="@mipmap/bxjs_yanglao"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40_60"
            android:layout_marginTop="@dimen/dp_15_22"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="@dimen/dp_30_45"
                android:layout_height="@dimen/dp_30_45"
                android:paddingEnd="@dimen/dp_20_30"
                android:layout_marginStart="@dimen/dp_10_15"
                android:src="@mipmap/sb_fh" />
        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/tv_jnjs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10_15"
                android:layout_marginTop="@dimen/dp_5_7"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="缴纳基数"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_9_13" />

                <ImageView
                    android:layout_width="@dimen/dp_10_15"
                    android:layout_height="@dimen/dp_10_15"
                    android:src="@mipmap/jfjs_gd" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_26_39"
                android:layout_marginLeft="@dimen/dp_10_15"
                android:layout_marginTop="@dimen/dp_5_7"
                android:layout_marginRight="@dimen/dp_10_15"
                android:background="@drawable/edit_bg"
                android:gravity="center_vertical"
                android:paddingRight="@dimen/dp_15_22">

                <EditText
                    android:id="@+id/et_cardinal_number"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_24_36"
                    android:layout_marginLeft="@dimen/dp_5_7"
                    android:layout_marginRight="@dimen/dp_15_22"
                    android:layout_weight="1"
                    android:background="#fff"
                    android:hint="请输入工资"
                    android:inputType="numberDecimal"
                    android:paddingStart="@dimen/dp_5_7"
                    android:textColorHint="#ff999999"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_10_15" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="元"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_10_15" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10_15"
                android:layout_marginTop="@dimen/dp_5_7"
                android:text="单位缴纳比例"
                android:textColor="#ff333333"
                android:textSize="@dimen/sp_9_13" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_26_39"
                android:layout_marginLeft="@dimen/dp_10_15"
                android:layout_marginTop="@dimen/dp_5_7"
                android:layout_marginRight="@dimen/dp_10_15"
                android:background="@drawable/edit_bg"
                android:gravity="center_vertical"
                android:paddingRight="@dimen/dp_15_22">

                <EditText
                    android:id="@+id/et_company"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_24_36"
                    android:layout_marginLeft="@dimen/dp_8_12"
                    android:layout_marginRight="@dimen/dp_15_22"
                    android:layout_weight="1"
                    android:background="#fff"
                    android:hint="请输入单位缴纳比例"
                    android:inputType="numberDecimal"
                    android:paddingStart="@dimen/dp_5_7"
                    android:textColorHint="#ff999999"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_10_15" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="%"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_10_15" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_presonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10_15"
                android:layout_marginTop="@dimen/dp_5_7"
                android:text="个人缴纳比例"
                android:textColor="#ff333333"
                android:textSize="@dimen/sp_9_13" />

            <LinearLayout
                android:id="@+id/ll_presonal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_26_39"
                android:layout_marginLeft="@dimen/dp_10_15"
                android:layout_marginTop="@dimen/dp_5_7"
                android:layout_marginRight="@dimen/dp_10_15"
                android:background="@drawable/edit_bg"
                android:gravity="center_vertical"
                android:paddingRight="@dimen/dp_15_22">

                <EditText
                    android:id="@+id/et_personal"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_24_36"
                    android:layout_marginLeft="@dimen/dp_8_12"
                    android:layout_marginRight="@dimen/dp_15_22"
                    android:layout_weight="1"
                    android:background="#fff"
                    android:hint="请输入个人缴纳比例"
                    android:inputType="numberDecimal"
                    android:paddingStart="@dimen/dp_5_7"
                    android:textColorHint="#ff999999"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_10_15" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="%"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_10_15" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tv_calculate"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_32_48"
                android:layout_marginLeft="@dimen/dp_20_30"
                android:layout_marginTop="@dimen/dp_10_15"
                android:layout_marginRight="@dimen/dp_20_30"
                android:background="@drawable/btn_bg"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/dp_13_19"
                    android:layout_height="@dimen/dp_13_19"
                    android:src="@mipmap/sy_ksjs" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_5_7"
                    android:gravity="center"
                    android:text="开始计算"
                    android:textColor="#ffffffff"
                    android:textSize="@dimen/sp_11_16" />
            </LinearLayout>
            <FrameLayout
                android:id="@+id/fl_info_ad"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/dp_5_7"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_5_7"
                android:background="#eee" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingStart="@dimen/dp_15_22"
                android:paddingRight="@dimen/dp_15_22"
                android:paddingBottom="@dimen/dp_20_30">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10_15"
                    android:text="不同地区和不同险种的缴费比例有所不同,"
                    android:textColor="#ff999999"
                    android:textSize="@dimen/sp_9_13" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="以常见比例为例"
                    android:textColor="#ff999999"
                    android:textSize="@dimen/sp_9_13" />

                <TextView
                    android:id="@+id/tv_hint1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="养老保险:企业缴纳比例一般为16%，职工个人缴费比例为 8%。"
                    android:textColor="#ff999999"
                    android:textSize="@dimen/sp_9_13" />

                <TextView
                    android:id="@+id/tv_hint2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="计算社保费用:社保缴费金额=缴费基数x缴费比例"
                    android:textColor="#ff999999"
                    android:textSize="@dimen/sp_9_13" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>


</LinearLayout>
