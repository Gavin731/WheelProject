<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fff"
    android:orientation="vertical">

    <include android:id="@+id/header" layout="@layout/view_top"/>
    <LinearLayout
        android:id="@+id/iv_top"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="vertical"
        android:background="@color/color_ef5b9c" >
        <TextView
            android:id="@+id/tv_name"
            android:text="11"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>
    <TextView
        android:id="@+id/tv_jnjs"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="10dp"
        android:drawableEnd="@mipmap/ic_launcher_round"
        android:text="缴纳基数" />

    <LinearLayout
        android:layout_width="match_parent"
        android:background="@drawable/edit_bg"
        android:gravity="center_vertical"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginTop="10dp"
        android:paddingRight="15dp"
        android:layout_height="40dp">
        <EditText
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="35dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:background="#fff"
            android:hint="请输入工资（元）"
            android:inputType="numberDecimal"

            android:paddingStart="5dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="元"/>
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="10dp"
        android:text="单位缴纳比例" />

    <LinearLayout
        android:layout_width="match_parent"
        android:background="@drawable/edit_bg"
        android:gravity="center_vertical"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginTop="10dp"
        android:paddingRight="15dp"
        android:layout_height="40dp">
        <EditText
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="35dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:background="#fff"
            android:hint="请输入单位缴纳比例"
            android:inputType="numberDecimal"

            android:paddingStart="5dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="%"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="10dp"
        android:text="个人缴纳比例" />

    <LinearLayout
        android:layout_width="match_parent"
        android:background="@drawable/edit_bg"
        android:gravity="center_vertical"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginTop="10dp"
        android:paddingRight="15dp"
        android:layout_height="40dp">
        <EditText
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="35dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:background="#fff"
            android:hint="请输入个人缴纳比例"
            android:inputType="numberDecimal"

            android:paddingStart="5dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="%"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_calculate"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="40dp"
        android:background="@drawable/btn_bg"
        android:drawableStart="@mipmap/ic_launcher_round"
        android:drawablePadding="5dp"
        android:gravity="center"
        android:text="开始计算"
        android:textColor="#fff" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="#eee"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="不同地区和不同险种的缴费比例有所不同,"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="以常见比例为例"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="养老保险:企业缴纳比例一般为16%，职工个人缴费比例为 8%。"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="计算社保费用:社保缴费金额=缴费基数x缴费比例"/>
    </LinearLayout>
</LinearLayout>
