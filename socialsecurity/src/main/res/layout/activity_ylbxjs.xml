<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ll_top"
        android:layout_width="match_parent"
        android:layout_height="106dp"
        android:background="@mipmap/bxjs_yanglao"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="15dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="43dp"
                android:layout_height="43dp"
                android:paddingEnd="30dp"
                android:layout_marginStart="10dp"
                android:src="@mipmap/sb_fh" />
        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/tv_jnjs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="缴纳基数"
                    android:textColor="#ff333333"
                    android:textSize="9sp" />

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@mipmap/jfjs_gd" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/edit_bg"
                android:gravity="center_vertical"
                android:paddingRight="15dp">

                <EditText
                    android:id="@+id/et_cardinal_number"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="15dp"
                    android:layout_weight="1"
                    android:background="#fff"
                    android:hint="请输入工资"
                    android:inputType="numberDecimal"
                    android:paddingStart="5dp"
                    android:textColorHint="#ff999999"
                    android:textColor="#ff333333"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="元"
                    android:textColor="#ff333333"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:text="单位缴纳比例"
                android:textColor="#ff333333"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/edit_bg"
                android:gravity="center_vertical"
                android:paddingRight="15dp">

                <EditText
                    android:id="@+id/et_company"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="15dp"
                    android:layout_weight="1"
                    android:background="#fff"
                    android:hint="请输入单位缴纳比例"
                    android:inputType="numberDecimal"
                    android:paddingStart="5dp"
                    android:textColorHint="#ff999999"
                    android:textColor="#ff333333"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="%"
                    android:textColor="#ff333333"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_presonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:text="个人缴纳比例"
                android:textColor="#ff333333"
                android:textSize="9sp" />

            <LinearLayout
                android:id="@+id/ll_presonal"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/edit_bg"
                android:gravity="center_vertical"
                android:paddingRight="15dp">

                <EditText
                    android:id="@+id/et_personal"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="15dp"
                    android:layout_weight="1"
                    android:background="#fff"
                    android:hint="请输入个人缴纳比例"
                    android:inputType="numberDecimal"
                    android:paddingStart="5dp"
                    android:textColorHint="#ff999999"
                    android:textColor="#ff333333"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="%"
                    android:textColor="#ff333333"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tv_calculate"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="20dp"
                android:background="@drawable/btn_bg"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@mipmap/sy_ksjs" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:gravity="center"
                    android:text="开始计算"
                    android:textColor="#ffffffff"
                    android:textSize="11sp" />
            </LinearLayout>
            <FrameLayout
                android:id="@+id/fl_info_ad"
                android:layout_width="match_parent"
                android:layout_marginTop="5dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:background="#eee" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingRight="15dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="不同地区和不同险种的缴费比例有所不同,"
                    android:textColor="#ff999999"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="以常见比例为例"
                    android:textColor="#ff999999"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tv_hint1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="养老保险:企业缴纳比例一般为16%，职工个人缴费比例为 8%。"
                    android:textColor="#ff999999"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tv_hint2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="计算社保费用:社保缴费金额=缴费基数x缴费比例"
                    android:textColor="#ff999999"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>


</LinearLayout>
