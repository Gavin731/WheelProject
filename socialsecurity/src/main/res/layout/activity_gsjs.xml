<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fff"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ll_top"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_140_210"
        android:background="@mipmap/gsjs"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40_60"
            android:layout_marginTop="@dimen/dp_15_22"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="@dimen/dp_30_45"
                android:layout_height="@dimen/dp_30_45"
                android:paddingEnd="@dimen/dp_20_30"
                android:layout_marginStart="@dimen/dp_10_15"
                android:src="@mipmap/sb_fh" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-15dp"
        android:layout_marginStart="@dimen/dp_8_12"
        android:text="本月工资收入"
        android:textColor="#ff333333"
        android:textSize="@dimen/sp_9_13" />

    <EditText
        android:id="@+id/et_gs_month_money"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_26_39"
        android:layout_marginLeft="@dimen/dp_8_12"
        android:layout_marginTop="@dimen/dp_5_7"
        android:layout_marginRight="@dimen/dp_15_22"
        android:background="@drawable/edit_bg"
        android:hint="请输入本月工资收入（元）"
        android:inputType="numberDecimal"
        android:paddingStart="@dimen/dp_5_7"
        android:textColor="#ff333333"
        android:textColorHint="#ff999999"
        android:textSize="@dimen/sp_10_15" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_8_12"
        android:layout_marginTop="@dimen/dp_10_15"
        android:text="五险一金（个人缴纳）"
        android:textColor="#ff333333"
        android:textSize="@dimen/sp_9_13" />

    <EditText
        android:id="@+id/et_gs_sb_money"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_26_39"
        android:layout_marginLeft="@dimen/dp_8_12"
        android:layout_marginTop="@dimen/dp_5_7"
        android:layout_marginRight="@dimen/dp_15_22"
        android:background="@drawable/edit_bg"
        android:hint="请输入五险一金个人缴纳部分（元）"
        android:inputType="numberDecimal"
        android:paddingStart="@dimen/dp_5_7"
        android:textColor="#ff333333"
        android:textColorHint="#ff999999"
        android:textSize="@dimen/sp_10_15" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_10_15"
        android:layout_marginTop="@dimen/dp_10_15"
        android:text="专项附加扣除"
        android:textColor="#ff333333"
        android:textSize="@dimen/sp_9_13" />

    <EditText
        android:id="@+id/et_gs_zxkc_money"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_26_39"
        android:layout_marginLeft="@dimen/dp_8_12"
        android:layout_marginTop="@dimen/dp_5_7"
        android:layout_marginRight="@dimen/dp_15_22"
        android:background="@drawable/edit_bg"
        android:hint="请输入专项附加扣除金额（元）"
        android:inputType="numberDecimal"
        android:paddingStart="@dimen/dp_5_7"
        android:textColor="#ff333333"
        android:textColorHint="#ff999999"
        android:textSize="@dimen/sp_10_15" />

    <LinearLayout
        android:id="@+id/tv_gs_calculate"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_32_48"
        android:layout_marginLeft="@dimen/dp_20_30"
        android:layout_marginTop="@dimen/dp_10_15"
        android:layout_marginRight="@dimen/dp_20_30"
        android:background="@drawable/btn_bg"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/dp_13_19"
            android:layout_height="@dimen/dp_13_19"
            android:src="@mipmap/sy_ksjs" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_5_7"
            android:gravity="center"
            android:text="开始计算"
            android:textColor="#ffffffff"
            android:textSize="@dimen/sp_11_16" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/fl_info_ad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_weight="1" />
</LinearLayout>