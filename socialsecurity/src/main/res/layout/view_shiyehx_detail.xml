<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10_15"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="@dimen/dp_4_6"
            android:layout_height="@dimen/dp_9_13"
            android:background="#3875F6" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_3_5"
            android:text="失业保险"
            android:textColor="#ff333333"
            android:textSize="@dimen/sp_11_16"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_3_5"
        android:text="是国家通过立法强制实行的，由社会集中建立基金，对因失业而暂时中断生活来源的劳动者提供物质帮助的制度。"
        android:textColor="#ff333333"
        android:textSize="@dimen/sp_11_16" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10_15"
        android:background="@drawable/bg_ylbx_funstion"
        android:orientation="vertical"
        android:padding="@dimen/dp_9_13">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="主要特点"
            android:textColor="#ff333333"
            android:textSize="@dimen/sp_11_16"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5_7"
            android:background="@drawable/bg_write_radius"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_9_13"
                    android:layout_marginTop="@dimen/dp_9_13"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/dp_12_18"
                        android:layout_height="@dimen/dp_12_18"
                        android:src="@mipmap/sh_zs" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_2_3"
                        android:text="强制性:"
                        android:textColor="#ff333333"
                        android:textSize="@dimen/sp_11_16"
                        android:textStyle="bold" />¬
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_9_13"
                    android:layout_marginTop="@dimen/dp_3_5"
                    android:layout_marginEnd="@dimen/dp_9_13"
                    android:text="由国家立法强制实施，符合条件的用人单位和劳动者必须依法参加失业保险，履行缴费义务。"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_10_15" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_9_13"
                    android:layout_marginTop="@dimen/dp_9_13"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/dp_12_18"
                        android:layout_height="@dimen/dp_12_18"
                        android:src="@mipmap/sh_zs" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_2_3"
                        android:text="互济性:"
                        android:textColor="#ff333333"
                        android:textSize="@dimen/sp_11_16"
                        android:textStyle="bold" />¬
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_9_13"
                    android:layout_marginTop="@dimen/dp_3_5"
                    android:layout_marginEnd="@dimen/dp_9_13"
                    android:text="通过建立失业保险基金，将众多用人单位和劳动者缴纳的保险费集中起来，对失业人员进行经济援助，实现了风险的分担和互助共济。"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_10_15" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_9_13"
                    android:layout_marginTop="@dimen/dp_9_13"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/dp_12_18"
                        android:layout_height="@dimen/dp_12_18"
                        android:src="@mipmap/sh_zs" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_2_3"
                        android:text="保障性:"
                        android:textColor="#ff333333"
                        android:textSize="@dimen/sp_11_16"
                        android:textStyle="bold" />¬
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_9_13"
                    android:layout_marginTop="@dimen/dp_3_5"
                    android:layout_marginEnd="@dimen/dp_9_13"
                    android:layout_marginBottom="@dimen/dp_10_15"
                    android:text="旨在保障失业人员在失业期间的基本生活，帮助他们度过难关，同时为其再就业提供一定的支持和帮助。"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_10_15" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10_15"
        android:background="@drawable/bg_ylbx_funstion"
        android:orientation="vertical"
        android:padding="@dimen/dp_9_13">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保险待遇"
            android:textColor="#ff333333"
            android:textSize="@dimen/sp_11_16"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5_7"
            android:background="@drawable/bg_write_radius"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_9_13"
                    android:layout_marginTop="@dimen/dp_9_13"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/dp_12_18"
                        android:layout_height="@dimen/dp_12_18"
                        android:src="@mipmap/sh_zs" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_2_3"
                        android:text="失业保险金:"
                        android:textColor="#ff333333"
                        android:textSize="@dimen/sp_11_16"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_9_13"
                    android:layout_marginTop="@dimen/dp_3_5"
                    android:layout_marginEnd="@dimen/dp_9_13"
                    android:text="这是失业人员最基本的待遇，是社会保险经办机构按规定支付给符合条件的失业者的基本生活费。"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_10_15" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_9_13"
                    android:layout_marginTop="@dimen/dp_9_13"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/dp_12_18"
                        android:layout_height="@dimen/dp_12_18"
                        android:src="@mipmap/sh_zs" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_2_3"
                        android:text="领取失业保险金期间的医疗补助金:"
                        android:textColor="#ff333333"
                        android:textSize="@dimen/sp_11_16"
                        android:textStyle="bold" />¬
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_9_13"
                    android:layout_marginTop="@dimen/dp_3_5"
                    android:layout_marginEnd="@dimen/dp_9_13"
                    android:layout_marginBottom="@dimen/dp_10_15"
                    android:text="通过建立失业保险基金，将众多用人单位和劳动者缴纳的保险费集中起来，对失业人员进行经济援助，实现了风险的分担和互助共济。对失业者在领取失业保险金期间患病就医的医疗费给予一定补助。
     \n\n领取失业保险金期间死亡的失业人员的丧葬补助金和其供养的配偶、直系亲属的抚恤金:过去这项费用由职工生前所在单位负担，现在改为向社会保险经办机构申领。
     \n\n领取失业保险金期间接受职业培训、职业介绍的补贴:包括失业者为接受职业培训所需的路费、住宿费、培训费等。"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_10_15" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>