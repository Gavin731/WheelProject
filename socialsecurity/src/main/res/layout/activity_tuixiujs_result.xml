<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fff"
    android:orientation="vertical">

    <include
        android:id="@+id/header"
        layout="@layout/view_top" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="#E4E5E9" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_10_15"
                android:layout_marginTop="@dimen/dp_20"
                android:gravity="center_vertical"
                android:paddingRight="@dimen/dp_15_22">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/dp_15_22"
                    android:layout_weight="1"
                    android:background="#fff"
                    android:text="法定退休年龄"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_10_15" />

                <TextView
                    android:id="@+id/tv_tuixiu_year_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1111"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_10_15" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="@dimen/dp_10_15"
                android:layout_marginTop="@dimen/dp_10_15"
                android:layout_marginRight="@dimen/dp_10_15"
                android:background="#E4E5E9" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_10_15"
                android:layout_marginTop="@dimen/dp_20"
                android:gravity="center_vertical"
                android:paddingRight="@dimen/dp_15_22">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/dp_15_22"
                    android:layout_weight="1"
                    android:background="#fff"
                    android:text="退休时间"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_10_15" />

                <TextView
                    android:id="@+id/tv_tuixiu_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1111"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_10_15" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="@dimen/dp_10_15"
                android:layout_marginTop="@dimen/dp_10_15"
                android:layout_marginRight="@dimen/dp_10_15"
                android:background="#E4E5E9" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_10_15"
                android:layout_marginTop="@dimen/dp_20"
                android:gravity="center_vertical"
                android:paddingRight="@dimen/dp_15_22">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/dp_15_22"
                    android:layout_weight="1"
                    android:background="#fff"
                    android:text="延迟月数"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_10_15" />

                <TextView
                    android:id="@+id/tv_delayMonths"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1111"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_10_15" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="@dimen/dp_10_15"
                android:layout_marginTop="@dimen/dp_10_15"
                android:layout_marginRight="@dimen/dp_10_15"
                android:background="#E4E5E9" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_10_15"
                android:layout_marginTop="@dimen/dp_20"
                android:gravity="center_vertical"
                android:paddingRight="@dimen/dp_15_22">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/dp_15_22"
                    android:layout_weight="1"
                    android:background="#fff"
                    android:text="距离退休还有"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_10_15" />

                <TextView
                    android:id="@+id/diff_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1111"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_10_15" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="@dimen/dp_10_15"
                android:layout_marginTop="@dimen/dp_10_15"
                android:layout_marginRight="@dimen/dp_10_15"
                android:background="#E4E5E9" />

            <TextView
                android:id="@+id/tv_back"
                android:layout_width="180dp"
                android:layout_height="@dimen/dp_32_48"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/dp_10_15"
                android:background="@drawable/btn_bg"
                android:drawablePadding="@dimen/dp_5_7"
                android:gravity="center"
                android:text="返回"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_11_16" />

            <FrameLayout
                android:id="@+id/fl_info_ad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_marginBottom="@dimen/dp_10_15"
                android:layout_weight="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_15_22"
                android:layout_marginTop="@dimen/dp_10_15"
                android:layout_marginEnd="@dimen/dp_15_22"
                android:paddingBottom="@dimen/dp_20_30"
                android:text="温馨提示:\n以上数据仅根据《全国人民代表大会常务委员会关于实施渐进式延迟退休年龄的决定》推算。数据仅供参考，不能作为任何凭证依据，如有新规，请参考最新规定!"
                android:textColor="#ff999999"
                android:textSize="@dimen/sp_9_13" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>