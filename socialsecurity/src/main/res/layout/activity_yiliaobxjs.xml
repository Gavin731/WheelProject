<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ll_top"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_106_159"
        android:background="@mipmap/yiliaojiaofei_jisuan"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40_60"
            android:layout_marginTop="@dimen/dp_15_22"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="@dimen/dp_30_45"
                android:layout_height="@dimen/dp_30_45"
                android:layout_marginStart="@dimen/dp_10_15"
                android:paddingEnd="@dimen/dp_20_30"
                android:src="@mipmap/sb_fh" />
        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp_10_15"
                android:background="@drawable/bg_ylbx_funstion"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp_10_15"
                    android:background="@drawable/bg_write_radius"
                    android:gravity="center"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/ll_left"
                            android:layout_width="@dimen/dp_40"
                            android:layout_height="@dimen/dp_40"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/dp_11_16"
                                android:layout_height="@dimen/dp_11_16"
                                android:src="@mipmap/wdsbzd_y1" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_year"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp_3_5"
                            android:layout_marginRight="@dimen/dp_3_5"
                            android:text="2025"
                            android:textColor="#ff333333"
                            android:textSize="@dimen/sp_10_15" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="1dp"
                            android:layout_marginRight="1dp"
                            android:text="年"
                            android:textColor="#ff333333"
                            android:textSize="@dimen/sp_10_15" />

                        <LinearLayout
                            android:id="@+id/ll_right"
                            android:layout_width="@dimen/dp_40"
                            android:layout_height="@dimen/dp_40"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/dp_11_16"
                                android:layout_height="@dimen/dp_11_16"
                                android:src="@mipmap/wdsbzd_y2" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="本年医保费用（元）"
                        android:textColor="#ff333333"
                        android:textSize="@dimen/sp_10_15" />

                    <TextView
                        android:id="@+id/tv_money"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="19222.88"
                        android:textColor="#ff333333"
                        android:textSize="@dimen/sp_35"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dp_10_15"
                        android:text="更新至：2025-09-21"
                        android:textColor="#ff999999"
                        android:textSize="@dimen/sp_9_13" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tv_calculate"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_32_48"
                android:layout_marginLeft="@dimen/dp_20_30"
                android:layout_marginTop="@dimen/dp_10_15"
                android:layout_marginRight="@dimen/dp_20_30"
                android:background="@drawable/btn_bg"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_5_7"
                    android:gravity="center"
                    android:text="添加费用"
                    android:textColor="#ffffffff"
                    android:textSize="@dimen/sp_11_16" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/fl_info_ad"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_weight="1" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_5_7"
                android:background="#eee" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp_10_15"
                android:background="@drawable/bg_ylbx_funstion"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_10_15"
                    android:layout_marginTop="@dimen/dp_10_15"
                    android:text="账单总览"
                    android:textSize="@dimen/sp_11_16"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp_10_15"
                    android:background="@drawable/bg_write_radius"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/ll_left_month"
                            android:layout_width="@dimen/dp_40"
                            android:layout_height="@dimen/dp_40"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/dp_11_16"
                                android:layout_height="@dimen/dp_11_16"
                                android:src="@mipmap/wdsbzd_y1" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_month"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp_3_5"
                            android:layout_marginRight="@dimen/dp_3_5"
                            android:text="10"
                            android:textColor="#ff333333"
                            android:textSize="@dimen/sp_10_15" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="1dp"
                            android:layout_marginRight="1dp"
                            android:text="月"
                            android:textColor="#ff333333"
                            android:textSize="@dimen/sp_10_15" />

                        <LinearLayout
                            android:id="@+id/ll_right_month"
                            android:layout_width="@dimen/dp_40"
                            android:layout_height="@dimen/dp_40"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/dp_11_16"
                                android:layout_height="@dimen/dp_11_16"
                                android:src="@mipmap/wdsbzd_y2" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp_10"
                        android:layout_marginRight="@dimen/dp_10"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="类型"
                            android:textColor="#ff999999"
                            android:textSize="@dimen/sp_9_13" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:gravity="center"
                            android:text="年花费"
                            android:textColor="#ff999999"
                            android:textSize="@dimen/sp_9_13" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="right"
                            android:text="占比"
                            android:textColor="#ff999999"
                            android:textSize="@dimen/sp_9_13" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_list"
                        android:layout_width="match_parent"
                        android:layout_height="160dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>


</LinearLayout>
