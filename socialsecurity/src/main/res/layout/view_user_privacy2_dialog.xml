<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/dp_206_309"
    android:layout_height="@dimen/dp_128_192"
    android:background="@drawable/bg_write_radius"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20_30"
        android:text="温馨提示"
        android:textColor="#ff000000"
        android:textSize="@dimen/sp_12_18" />

    <TextView
        android:id="@+id/tv_content"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/dp_20_30"
        android:layout_marginTop="@dimen/dp_10_15"
        android:layout_marginEnd="@dimen/dp_20_30"
        android:layout_weight="1"
        android:text="1"
        android:textColor="#ff333333"
        android:textSize="@dimen/sp_10_15" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="#E1E1E1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_27_40"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_find_user_privacy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/btn_bg_bottom_left_round"
            android:gravity="center"
            android:text="查看协议"
            android:textColor="#ff888888"
            android:textSize="@dimen/sp_11_16" />

        <TextView
            android:id="@+id/tv_ok_user_privacy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/btn_bg_bottom_right_round"
            android:gravity="center"
            android:text="同意并继续"
            android:textColor="#ffffffff"
            android:textSize="@dimen/sp_11_16" />
    </LinearLayout>
</LinearLayout>