<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="@dimen/dp_16_24"
        android:layout_height="@dimen/dp_16_24"
        android:src="@mipmap/icon_home_tab_home" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_2_3"
        android:text="首页"
        android:textColor="#ff407aec"
        android:textSize="@dimen/sp_8_12" />
</LinearLayout>