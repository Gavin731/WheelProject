<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="50dp" />

    <LinearLayout
        android:layout_width="@dimen/dp_202_303"
        android:layout_height="@dimen/dp_126_189"
        android:background="@mipmap/sy_tc"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="@dimen/dp_10_15"
            android:layout_height="@dimen/dp_10_15"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/dp_5_7"
            android:layout_marginEnd="@dimen/dp_5_7"
            android:src="@mipmap/sytc_gb" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="社保在线计算"
            android:textColor="#ff000000"
            android:textSize="@dimen/sp_12_18" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8_12"
            android:layout_marginTop="@dimen/dp_18_27"
            android:layout_marginEnd="@dimen/dp_8_12"
            android:text="掌握缴费基数、比例、年限、保障未来更从容。"
            android:textColor="#ff666666"
            android:textSize="@dimen/sp_10_15" />

        <LinearLayout
            android:id="@+id/tv_showUserPrivacy"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_32_48"
            android:layout_marginLeft="@dimen/dp_20_30"
            android:layout_marginTop="@dimen/dp_10_15"
            android:layout_marginRight="@dimen/dp_20_30"
            android:background="@drawable/btn_bg_tc"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/dp_13_19"
                android:layout_height="@dimen/dp_13_19"
                android:src="@mipmap/sy_ksjs" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_5_7"
                android:gravity="center"
                android:text="立即使用"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_11_16" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/fl_info_ad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp" />
    </LinearLayout>
</LinearLayout>
