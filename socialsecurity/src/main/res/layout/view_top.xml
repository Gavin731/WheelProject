<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#ffffff"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_22_33" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_30_45"
        android:background="#fff"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="@dimen/dp_30_45"
            android:layout_height="@dimen/dp_30_45"
            android:layout_marginStart="@dimen/dp_10_15"
            android:paddingEnd="@dimen/dp_20_30"
            android:src="@mipmap/sb_fh" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_40_60_"
            android:gravity="center"
            android:text="标题"
            android:textColor="#ff333333"
            android:textSize="@dimen/sp_12_18"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>