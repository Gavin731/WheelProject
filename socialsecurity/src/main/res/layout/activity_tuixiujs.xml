<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ll_top"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_106_159"
        android:background="@mipmap/tuixiu_jisuan"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40_60"
            android:layout_marginTop="@dimen/dp_15_22"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="@dimen/dp_30_45"
                android:layout_height="@dimen/dp_30_45"
                android:layout_marginStart="@dimen/dp_10_15"
                android:paddingEnd="@dimen/dp_20_30"
                android:src="@mipmap/sb_fh" />
        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10_15"
                android:layout_marginTop="@dimen/dp_5_7"
                android:text="基础信息"
                android:textColor="#ff333333"
                android:textSize="@dimen/sp_9_13" />

            <LinearLayout
                android:id="@+id/ll_select_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_10_15"
                android:layout_marginTop="@dimen/dp_10_15"
                android:gravity="center_vertical"
                android:paddingRight="@dimen/dp_15_22">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/dp_15_22"
                    android:layout_weight="1"
                    android:background="#fff"
                    android:text="出生年月"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_10_15" />

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="请选择"
                    android:textColor="#ff333333"
                    android:textColorHint="#ff999999"
                    android:textSize="@dimen/sp_10_15" />

                <ImageView
                    android:layout_width="@dimen/dp_8_12"
                    android:layout_height="@dimen/dp_8_12"
                    android:layout_marginLeft="@dimen/dp_5_7"
                    android:src="@mipmap/gdgj_yjt" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="@dimen/dp_10_15"
                android:layout_marginTop="@dimen/dp_10_15"
                android:layout_marginRight="@dimen/dp_10_15"
                android:background="#E4E5E9" />

            <LinearLayout
                android:id="@+id/ll_select_sex_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_10_15"
                android:layout_marginTop="@dimen/dp_10_15"
                android:gravity="center_vertical"
                android:paddingRight="@dimen/dp_15_22">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/dp_15_22"
                    android:layout_weight="1"
                    android:background="#fff"
                    android:text="性别及人员类型"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_10_15" />


                <TextView
                    android:id="@+id/tv_sex_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="请选择"
                    android:textColor="#ff333333"
                    android:textColorHint="#ff999999"
                    android:textSize="@dimen/sp_10_15" />

                <ImageView
                    android:layout_width="@dimen/dp_8_12"
                    android:layout_height="@dimen/dp_8_12"
                    android:layout_marginLeft="@dimen/dp_5_7"
                    android:src="@mipmap/gdgj_yjt" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="@dimen/dp_10_15"
                android:layout_marginTop="@dimen/dp_10_15"
                android:layout_marginRight="@dimen/dp_10_15"
                android:background="#E4E5E9" />

            <LinearLayout
                android:id="@+id/tv_calculate"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_32_48"
                android:layout_marginLeft="@dimen/dp_20_30"
                android:layout_marginTop="@dimen/dp_10_15"
                android:layout_marginRight="@dimen/dp_20_30"
                android:background="@drawable/btn_bg"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_5_7"
                    android:gravity="center"
                    android:text="开始计算"
                    android:textColor="#ffffffff"
                    android:textSize="@dimen/sp_11_16" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingStart="@dimen/dp_15_22"
                android:paddingRight="@dimen/dp_15_22"
                android:paddingBottom="@dimen/dp_20_30">

                <TextView
                    android:id="@+id/tv_click_href"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10_15"
                    android:gravity="center"
                    android:text="关于实施渐进式延迟法定退休年龄的决定"
                    android:textColor="#3875F6"
                    android:textSize="@dimen/sp_9_13" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/fl_info_ad"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_weight="1" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_5_7"
                android:background="#eee" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingStart="@dimen/dp_15_22"
                android:paddingRight="@dimen/dp_15_22"
                android:paddingBottom="@dimen/dp_20_30">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10_15"
                    android:text="说明:按照《关于实施渐进式延迟法定退休年龄的决定》附表对照关系，您通过全能退休计算器，选择出生年月、性别及人员类型，即可计算出对应改革后法定退休年龄、改革后退休时间、延迟月数。"
                    android:textColor="#ff999999"
                    android:textSize="@dimen/sp_9_13" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>


</LinearLayout>
