<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ll_top"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_126_189"
        android:background="@mipmap/banner1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40_60"
            android:layout_marginTop="@dimen/dp_15_22"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="@dimen/dp_30_45"
                android:layout_height="@dimen/dp_30_45"
                android:paddingEnd="@dimen/dp_20_30"
                android:layout_marginStart="@dimen/dp_10_15"
                android:src="@mipmap/sb_fh" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-40dp"
                android:gravity="center"
                android:text="标题"
                android:textColor="#ff333333"
                android:textSize="@dimen/sp_12_18" />
        </LinearLayout>

    </LinearLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10_15"
                android:layout_marginTop="@dimen/dp_10_15"
                android:layout_marginEnd="@dimen/dp_10_15"
                android:background="@drawable/bg_ylbx_funstion"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_5_7"
                    android:layout_marginTop="@dimen/dp_9_13"
                    android:text="扣除范围"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_11_16"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_kcfw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp_10_15"
                    android:background="@drawable/bg_write_radius"
                    android:padding="@dimen/dp_10_15"
                    android:text="111"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_10_15" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10_15"
                android:layout_marginTop="@dimen/dp_10_15"
                android:layout_marginEnd="@dimen/dp_10_15"
                android:background="@drawable/bg_ylbx_funstion"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_5_7"
                    android:layout_marginTop="@dimen/dp_9_13"
                    android:text="扣除标准"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_11_16"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_kcbz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp_10_15"
                    android:background="@drawable/bg_write_radius"
                    android:padding="@dimen/dp_10_15"
                    android:text="111"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_10_15" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10_15"
                android:layout_marginTop="@dimen/dp_10_15"
                android:layout_marginEnd="@dimen/dp_10_15"
                android:background="@drawable/bg_ylbx_funstion"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_5_7"
                    android:layout_marginTop="@dimen/dp_9_13"
                    android:text="扣除方式"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_11_16"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_kcfs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp_10_15"
                    android:background="@drawable/bg_write_radius"
                    android:padding="@dimen/dp_10_15"
                    android:text="111"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_10_15" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10_15"
                android:layout_marginTop="@dimen/dp_10_15"
                android:layout_marginEnd="@dimen/dp_10_15"
                android:layout_marginBottom="@dimen/dp_10_15"
                android:background="@drawable/bg_ylbx_funstion"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_5_7"
                    android:layout_marginTop="@dimen/dp_9_13"
                    android:text="常见问题"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_11_16"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_cjwt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp_10_15"
                    android:background="@drawable/bg_write_radius"
                    android:padding="@dimen/dp_10_15"
                    android:text="111"
                    android:textColor="#ff333333"
                    android:textSize="@dimen/sp_10_15" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
